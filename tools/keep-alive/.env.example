# Set this on any host where the port is publicly reachable. Not needed locally, where
# docker-compose binds the port to loopback and you reach the dashboard over an SSH tunnel.
DASHBOARD_PASSWORD=

# Server. 4311 because task-notif already has 4310 on the same VM.
PORT=4311
# Where keep-alive.json lives. Relative paths resolve against the working directory: on
# your machine that is tools/keep-alive, inside the container it is WORKDIR /app, so
# ./data there is /app/data — the mounted volume.
DATA_DIR=./data

# One-off import of the kept list from task-notif, run once and recorded as importedAt in
# keep-alive.json (see README). Point it at a SNAPSHOT of task-notif's store.json taken
# before the new task-notif started — that version drops the keepAlive block on its next
# write. The repo's deploy/deploy.sh takes the snapshot and deploy/docker-compose.yml sets
# this to /app/data/legacy-task-notif-store.json; only set it here when running by hand.
# LEGACY_TASK_NOTIF_STORE=./data/legacy-task-notif-store.json
