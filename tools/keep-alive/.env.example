# Set this on any host where the port is publicly reachable. Not needed locally, where
# docker-compose binds the port to loopback and you reach the dashboard over an SSH tunnel.
DASHBOARD_PASSWORD=

# Server. 4311 because task-notif already has 4310 on the same VM.
PORT=4311
DATA_DIR=./data

# One-off import of the kept list from task-notif, on the first boot only (see README).
# On the VM: mount task-notif's data directory read-only (the commented volume line in
# docker-compose.yml) and point this at its store.json. Drop both once it has imported.
# LEGACY_TASK_NOTIF_STORE=/legacy/store.json
